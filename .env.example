# AI Learning Buddy Configuration Template
# Copy this file to a new file named '.env' and fill in your keys.

# 1. Google Gemini API Configuration
# Get your Gemini API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# The Gemini model to use. Recommended options:
# - gemini-1.5-flash (Fast, cost-effective, standard)
# - gemini-2.0-flash (Latest flash model)
# - gemini-1.5-pro (For complex logic or deep explanations)
GEMINI_MODEL=gemini-1.5-flash

# 2. ngrok Configuration (Required only if exposing via Google Colab / local tunnel)
# Get your ngrok token from: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTH_TOKEN=your_ngrok_auth_token_here

# 3. Application Logging and Port Settings
LOG_LEVEL=INFO
PORT=8501
